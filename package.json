{
  "name": "mobiledope",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "dupes": "jscpd",
    "lint:cpd": "jscpd . --config .jscpd.json",
    "lint:cpd:ci": "jscpd . --config .jscpd.json --threshold 5",
    "links": "lychee --no-progress \"**/*.md\"",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm audit --audit-level=high",
    "security:osv": "osv-scanner --lockfile=package-lock.json",
    "security:semgrep": "semgrep --config=p/typescript --config=p/javascript --config=p/react --config=p/owasp-top-ten --config=p/secrets --error --metrics=off",
    "security:secrets": "gitleaks detect --no-banner",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;Unlicense;Python-2.0;WTFPL;BlueOak-1.0.0;CC-BY-4.0;CC-BY-3.0;Unicode-DFS-2016;Unicode-3.0;MPL-2.0' --excludePrivatePackages --summary",
    "check": "npm-run-all -p lint type-check markdownlint dupes",
    "check:all": "npm-run-all -s check format:check test",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.12.0",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.12.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.18",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.4",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "victory-native": "^41.20.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.0.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "65.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.17",
    "jscpd": "^4.0.8",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "0.22.1",
    "npm-run-all2": "9.0.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsc-files": "1.1.4",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "private": true
}
