{
  "name": "mobiledope",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=625",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "rm -rf coverage && jest --coverage",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "dupes": "jscpd",
    "lint:cpd": "jscpd . --config .jscpd.json",
    "lint:cpd:ci": "jscpd . --config .jscpd.json",
    "links": "lychee --no-progress \"**/*.md\"",
    "security:audit": "node scripts/security-audit.mjs",
    "security:check": "npm audit --audit-level=high",
    "security:osv": "node scripts/security-osv.mjs",
    "security:semgrep": "semgrep --config=security/config/semgrep.yml --config=p/typescript --config=p/javascript --config=p/react --config=p/owasp-top-ten --config=p/secrets --severity=ERROR --error --metrics=off",
    "security:secrets": "gitleaks detect --no-banner --redact --baseline-path security/config/gitleaks-baseline.json",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;Apache-2.0;Apache 2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;Unlicense;Python-2.0;WTFPL;BlueOak-1.0.0;CC-BY-4.0;CC-BY-3.0;Unicode-DFS-2016;Unicode-3.0;MPL-2.0' --excludePrivatePackages --summary",
    "check": "npm-run-all -p lint type-check markdownlint dupes",
    "check:all": "npm-run-all -s check format:check test",
    "prepare": "husky",
    "security:audit:raw": "npm audit --audit-level=high",
    "security:all": "npm-run-all -s security:audit security:osv security:semgrep security:secrets",
    "security:osv:raw": "osv-scanner --lockfile=package-lock.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.12.0",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.12.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.28",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-keep-awake": "~55.0.8",
    "expo-location": "~55.1.12",
    "expo-print": "~55.0.17",
    "expo-sensors": "~55.0.17",
    "expo-sharing": "~55.0.22",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "victory-native": "^41.20.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@jest/transform": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@testing-library/react-native": "^13.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "~19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.47.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.0.2",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "65.0.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "jest-util": "^29.7.0",
    "js-yaml": "5.4.0",
    "jscpd": "^4.0.8",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "0.22.1",
    "npm-run-all2": "9.0.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.4.6",
    "tsc-files": "1.1.4",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "private": true,
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  }
}
