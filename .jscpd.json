{
  "comment": "threshold is set above the current ~8% duplication so the gate is green today; ratchet it down in follow-ups as duplication in screens/PDF templates is reduced (see docs/adr/010).",
  "threshold": 10,
  "minTokens": 50,
  "minLines": 5,
  "maxLines": 1000,
  "maxSize": "100kb",
  "reporters": ["console", "html"],
  "output": "./reports/jscpd",
  "format": ["typescript", "tsx", "javascript", "jsx", "json", "markdown"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/reports/**",
    "**/android/**",
    "**/ios/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/package-lock.json",
    "**/*.min.*"
  ],
  "absolute": true,
  "gitignore": true
}
