{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": true,
    "MD029": { "style": "ordered" },
    "MD033": { "allowed_elements": ["br", "details", "summary", "kbd", "sub", "sup"] },
    "MD040": true,
    "MD041": true,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    // Emphasis style must match what Prettier emits, or the two gates fight over
    // every italic: Prettier normalises `*em*` to `_em_`, while `**strong**` stays
    // asterisks. Asking markdownlint for asterisk emphasis made any italic text
    // unformattable (prettier --write and markdownlint --fix would undo each other).
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    // MD060 (table-column-style) is newer than this config's source and overly
    // pedantic about table pipe spacing; disabled to avoid reformatting tables.
    "MD060": false,
  },
  "ignores": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "reports/",
    "android/",
    "ios/",
    ".expo/",
    "CHANGELOG.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    // description.md is the imported product specification: a large, pre-existing
    // reference document with its own structure that predates these lint rules
    // and is not actively maintained here.
    "description.md",
  ],
}
