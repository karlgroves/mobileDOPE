# Secret gate FIRST: it is the cheapest check (~0.2s, diff-scoped) and the
# only irreversible one — a pushed credential must be rotated regardless.
# Running it before the test suite means you learn in a second, not a minute,
# and it cannot be skipped by an earlier `exit` in this hook.
# Guarded because .husky/pre-push is tracked: without ~/.fleet-security
# the missing file returns 127, and `|| exit 1` would block every push.
# The gate itself already soft-skips when gitleaks is absent.
FLEET_SECRET_GATE="$HOME/.fleet-security/bin/pre-push-secrets"
if [ -x "$FLEET_SECRET_GATE" ]; then
  "$FLEET_SECRET_GATE" || exit 1
fi

# Full local quality gate before pushing.
#
# ADR-011 puts the gates here rather than in GitHub Actions, so anything that is
# meant to block has to run in this hook — an npm script that no hook invokes is
# opt-in tooling, not a gate. Issue #45 wired the security scans in for that reason.

# `set -e` is load-bearing. Without it a failing command here does not stop the
# push: sh returns the exit status of the LAST command, so `npm run check` could
# fail and the hook would still exit 0 as long as the final gitleaks scan passed.
# That was true of this hook as first written, which made the headline quality
# gate the one step that could not block a push.
set -e

# lint (warning-capped), typecheck, markdownlint, dupes
npm run check

# Dependency advisories, gated against security/config/audit-waivers.json.
# Fails on anything not individually waived, and on any expired waiver.
npm run security:audit

# Lockfile scan, gated at CRITICAL and honouring the same waiver register as the
# audit above (scripts/security-osv.mjs). Optional binary: reported when absent,
# because it is a second source for advisories the audit gate already covers.
if command -v osv-scanner >/dev/null 2>&1; then
  npm run security:osv || exit 1
else
  echo "ℹ osv-scanner not installed — lockfile scan skipped (npm audit gate still ran)"
fi

# SAST. ERROR-severity rules block; WARNING-severity rules are advisory.
# See security/config/semgrep.yml and security-thresholds.json.
if command -v semgrep >/dev/null 2>&1; then
  npm run security:semgrep || exit 1
else
  echo "ℹ semgrep not installed — SAST skipped (run ./scripts/bootstrap.sh to enable)"
fi

# Secret scan over full history — what this push would publish.
# Fails when the tool is absent or cannot run; see scripts/security-secrets.mjs.
#
# There is no baseline file. The gitleaks one was an empty array, so nothing was
# being excluded, and carrying an empty exclusion list forward would only invite
# someone to add to it. If an exclusion is ever genuinely needed, add a deliberate
# --exclude-paths in the script where it can be read and reviewed.
npm run --silent security:secrets
